---
interface Props {
    title: string;
    description: string;
    pubDate: Date;
    slug: string;
}

const {
    title,
    description,
    pubDate,
    slug
} = Astro.props;
---

<article class="border-b border-zinc-800 pb-6">
    <a href={`/blog/${slug}`} class="group">
        <h2 class="text-2xl font-semibold group-hover:text-zinc-400">
            {title}
        </h2>

        <p class="mt-2 text-zinc-400">
            {description}
        </p>

        <p class="mt-3 text-sm text-zinc-500">
            {pubDate.toLocaleDateString("id-ID")}
        </p>
    </a>
</article>