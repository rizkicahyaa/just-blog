---
interface Props {
    title?: string;
}

const {
    title = "My Blog"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>
</head>

<body class="bg-zinc-950 text-white">

    <slot />

</body>
</html>